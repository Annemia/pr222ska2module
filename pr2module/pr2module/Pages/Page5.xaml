<Page x:Class="pr2module.Pages.Page5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr2module.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page5" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Строк (N):" VerticalAlignment="Center"/>
                <TextBox x:Name="tbRows" Width="50" Height="25" Margin="5,0,15,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Столбцов (M):" VerticalAlignment="Center"/>
                <TextBox x:Name="tbCols" Width="50" Height="25" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
            <Button x:Name="btnExecuteTask5" Content="Выполнить" Height="30" Width="220" HorizontalAlignment="Left" Margin="0,0,0,15" Click="btnExecuteTask5_Click"/>
            <TextBlock Text="Исходный массив:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DataGrid x:Name="dgOriginal" Height="120" IsReadOnly="True" AutoGenerateColumns="True" Margin="0,0,0,10"/>
            <TextBlock Text="Сортировка по возрастанию:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DataGrid x:Name="dgAscending" Height="120" IsReadOnly="True" AutoGenerateColumns="True" Margin="0,0,0,10"/>
            <TextBlock Text="Сортировка по убыванию:" FontWeight="Bold" Margin="0,0,0,5"/>
            <DataGrid x:Name="dgDescending" Height="120" IsReadOnly="True" AutoGenerateColumns="True" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBlock Text="Минимум:" FontWeight="Bold"/>
                <TextBox x:Name="tbMin" IsReadOnly="True" Width="60" Height="25" Margin="5,0,20,0" VerticalContentAlignment="Center"/>
                <TextBlock Text="Максимум:" FontWeight="Bold"/>
                <TextBox x:Name="tbMax" IsReadOnly="True" Width="60" Height="25" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
