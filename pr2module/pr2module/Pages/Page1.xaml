<Page x:Class="pr2module.Pages.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page1" Background="#FF5882D4">

    <StackPanel Margin="20">
        <TextBlock Text="Введите число (-999..999):"/>
        <TextBox x:Name="tbInputNumber" Height="25" Margin="0,5,0,15"/>
        <Button x:Name="btnExecuteTask1" Content="Выполнить" Height="30" Margin="0,0,0,15" Click="btnExecuteTask1_Click"/>
        <TextBlock Text="Результат:"/>
        <TextBox x:Name="tbResultTask1" IsReadOnly="True" Height="25" Margin="0,5,0,0"/>
    </StackPanel>
</Page>


