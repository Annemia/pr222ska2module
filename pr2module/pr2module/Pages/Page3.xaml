<Page x:Class="pr2module.Pages.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page3" Background="#FF99D8CB">
    <StackPanel Margin="20">
        <TextBlock Text="Введите координаты точек через пробел (например: 1 5 3 10):"/>
        <TextBox x:Name="tbInputArray" Height="25" Margin="0,5,0,15"/>
        <Button x:Name="btnExecuteTask3" Content="Выполнить" Height="30" Margin="0,0,0,15" Click="btnExecuteTask3_Click"/>
        <TextBlock Text="Результат:"/>
        <TextBox x:Name="tbResultTask3" IsReadOnly="True" Height="25" Margin="0,5,0,0"/>
    </StackPanel>
</Page>
