<Page x:Class="pr2module.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Page2" Background="#FFFD8E8E">
    <StackPanel Margin="20">
        <TextBlock Text="Введите строку с словами:"/>
        <TextBox x:Name="tbInputString" Height="25" Margin="0,5,0,15"/>
        <Button x:Name="btnExecuteTask2" Content="Выполнить" Height="30" Margin="0,0,0,15" Click="btnExecuteTask2_Click"/>
        <TextBlock Text="Результат (длина самого длинного слова):"/>
        <TextBox x:Name="tbResultTask2" IsReadOnly="True" Height="25" Margin="0,5,0,0"/>
    </StackPanel>
</Page>
