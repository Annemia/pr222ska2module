<Page x:Class="pr2module.Pages.Page4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr2module.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page4" Background="White">
    <StackPanel Margin="20">
        <TextBlock Text="Введите элементы массива через пробел:"/>
        <TextBox x:Name="tbInputArray" Height="25" Margin="0,5,0,15" TextChanged="tbInputArray_TextChanged"/>
        <Button x:Name="btnExecuteTask4" Content="Выполнить" Height="30" Margin="0,0,0,15" Click="btnExecuteTask4_Click"/>
        <TextBlock Text="Результат:"/>
        <TextBox x:Name="tbResultTask4" IsReadOnly="True" Height="25" Margin="0,5,0,0"/>
    </StackPanel>
</Page>
